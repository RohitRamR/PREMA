# Copy to .env and fill in. .env is gitignored.

# Sentry error tracking. Leave empty to keep Sentry off (local dev, Expo Go).
# The DSN is safe to ship in the app; it only allows sending events.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only (EAS secrets / CI), used to upload source maps.
# Never commit a real auth token.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
